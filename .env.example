# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nepselligence:nepselligence@localhost:5432/nepselligence

# ── NepseAPI (Unofficial) ─────────────────────────────────────────────────────
NEPSE_API_URL=http://nepseapi:8000
NEPSE_API_TIMEOUT=30
NEPSE_UNOFFICIAL_API_TLS_VERIFY=false

# ── Claude AI (required for AI insights) ──────────────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-...
CLAUDE_API_MAX_TOKENS=2000
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_DEEP=claude-sonnet-4-6

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kathmandu
SCHEDULER_MAX_INSTANCES=1

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
