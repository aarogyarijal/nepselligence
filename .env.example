# Backend configuration

# Database
DATABASE_URL=postgresql://nepselligence:nepselligence@localhost:5432/nepselligence

# NepseAPI (self-hosted Docker)
NEPSE_API_URL=http://localhost:8000
NEPSE_API_TIMEOUT=30

# NepseUnofficialApi (fallback)
NEPSE_UNOFFICIAL_API_TLS_VERIFY=False

# Scheduler
SCHEDULER_TIMEZONE=Asia/Kathmandu
SCHEDULER_MAX_INSTANCES=1

# Claude API (for AI insights)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_API_MAX_TOKENS=2000

# Server
ENVIRONMENT=development
LOG_LEVEL=INFO
